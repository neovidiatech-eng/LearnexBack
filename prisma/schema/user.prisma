model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  password     String?
  phone        String?  @unique
  country      String?
  profilePhoto String?
  coverPhoto   String?
  provider     String   @default("SYSTEM")
  status       String   @default("ACTIVE")
  confirmEmail Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  student Student?
  teacher Teacher?

  courses           Course[]           @relation("TutorCourses")
  courseEnrollments CourseEnrollment[] @relation("StudentEnrollments")
  courseReviews     CourseReview[]     @relation("StudentCourseReviews")
  coupunRedemptions CoupunRedemption[]
  teacherReviews    TeacherReview[]    @relation("StudentTeacherReviews")

  @@index([roleId])
  @@index([status])
  @@index([email])
  @@map("users")
}

model Student {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("students")
}

model Teacher {
  id                 String               @id @default(uuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYears    Int                  @default(0)
  cvUrl              String?
  referralCode       String?
  linkedinUrl        String?
  isAvailable        Boolean              @default(true)
  sessionPrice50Min  Decimal?             @default(0.0) @db.Decimal(10, 2)
  currency           String               @default("USD")
  avgRating          Decimal              @default(0.0) @db.Decimal(3, 2)
  totalStudentsCount Int                  @default(0)
  reviewsCount       Int                  @default(0)
  totalCoursesCount  Int                  @default(0)
  rejectionReason    String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  translations       TeacherTranslation[]
  certificates       TeacherCertificate[]
  reviews            TeacherReview[]

  @@index([userId])
  @@map("teachers")
}

model TeacherTranslation {
  id        String  @id @default(uuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  locale    String
  subject   String
  headline  String?
  bio       String? @db.Text

  @@unique([teacherId, locale])
  @@map("teacher_translations")
}

model TeacherCertificate {
  id        String  @id @default(uuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  title     String
  issuer    String?
  issueDate DateTime?
  fileUrl   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([teacherId])
  @@map("teacher_certificates")
}

model TeacherReview {
  id      String  @id @default(uuid())
  rating  Int
  comment String? @db.Text

  studentId String
  student   User   @relation("StudentTeacherReviews", fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  bookingId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, teacherId])
  @@index([teacherId])
  @@index([studentId])
  @@map("teacher_reviews")
}
