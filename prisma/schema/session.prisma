
model SessionPlan {
  id                       String                   @id @default(uuid())
  teacherId                String
  teacher                  Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  color                    String?                  @default("#b36c14ff")
  sessionsCount            Int
  price                    Decimal                  @db.Decimal(10, 2)
  discountType             String?
  discountValue            Decimal?                 @db.Decimal(10, 2)
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  sessionPlansTranslations SessionPlanTranslation[]

  @@index([teacherId])
  @@map("session_plans")
}

model SessionPlanTranslation {
  id          String      @id @default(uuid())
  sessionId   String
  sessionPlan SessionPlan @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lang        String
  title       String
  description String       @db.Text
  slug        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([sessionId, lang])
  @@index([sessionId])
  @@map("session_plans_translations")
}
