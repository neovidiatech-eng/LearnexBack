model SessionPlan {
  id                       String                   @id @default(uuid())
  teacherId                String
  teacher                  Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  color                    String?                  @default("#b36c14ff")
  sessionsCount            Int
  price                    Decimal                  @db.Decimal(10, 2)
  discountType             String?
  discountValue            Decimal?                 @db.Decimal(10, 2)
  validityDays             Int?                     @default(30)
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  sessionPlansTranslations SessionPlanTranslation[]
  students                 Student[]
  subscriptions            teacherSubscription[]

  @@index([teacherId])
  @@map("session_plans")
}

model SessionPlanTranslation {
  id          String      @id @default(uuid())
  sessionId   String
  sessionPlan SessionPlan @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lang        String
  title       String
  description String      @db.Text
  slug        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([sessionId, lang])
  @@index([sessionId])
  @@map("session_plans_translations")
}

model SessionRequest {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title          String?
  startAt        DateTime
  endAt          DateTime
  note           String?
  status         String    @default("PENDING") // PENDING,ACCEPTED,REJECTED,CANCELLED,COMPLETED,IN_PROGRESS
  rejectedReason String?
  respondedAt    DateTime?
  session        Session?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, status, startAt])
  @@index([studentId, status])
  @@map("session_requests")
}

model Session {
  id              String         @id @default(uuid())
  requestId       String         @unique
  request         SessionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  roomName        String?        @unique
  status          String         @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | CANCELLED
  startAt         DateTime
  endAt           DateTime
  studentJoinedAt DateTime?
  studentLeftAt   DateTime?
  actualEndAt     DateTime?
  actualStartAt   DateTime?
  teacherSubscriptionId String?
  teacherSubscription   teacherSubscription? @relation(fields: [teacherSubscriptionId], references: [id], onDelete: SetNull)
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, startAt])
  @@index([studentId, startAt])
  @@index([status])
  @@index([teacherSubscriptionId])
  @@map("sessions")
}

model CustomSessionRequest {
  id              String    @id @default(uuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sessionsCount   Int
  pricePerSession Decimal   @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  rejectedReason  String?
  respondedAt     DateTime?
  validityDays    Int       @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, status])
  @@index([studentId, status])
  @@map("custom_session_requests")
}
