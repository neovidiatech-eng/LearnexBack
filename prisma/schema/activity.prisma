model ActivityLog {
  id String @id @default(uuid())

  actorId String?

  userName String
  role     String

  action    String
  module    String  @default("Auth")
  status    String  @default("SUCCESS")
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([module])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id                       String                    @id @default(uuid())
  receiverId               String
  receiverType             String
  link                     String?
  type                     String                    @default("INFO")
  priority                 String                    @default("LOW")
  isRead                   Boolean                   @default(false)
  readAt                   DateTime?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  notificationTranslations NotificationTranslation[]


  @@index([isRead])
  @@index([receiverId])
  @@index([receiverType])
  @@index([type])
  @@index([priority])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTranslation {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  locale         String
  title          String?
  message        String?

  @@unique([notificationId, locale])
  @@map("notification_translations")
}
