model TeacherCourse {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  wallPaper       String?
  previewVideoUrl String?
  provider        String  @default("TEACHER") // TEACHER | PLATFORM
  level           String  @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED | ALL_LEVELS
  language        String  @default("english") // english | arabic
  name            String
  description     String  @db.Text
  price           Decimal @db.Decimal(10, 2)
  totalHours      Int     @default(0)

  status          String  @default("PENDING") //PENDING,APPROVED,REJECTED
  rejectionReason String?

  totalStudentsCount Int     @default(0)
  avgRating          Decimal @default(0.0) @db.Decimal(3, 2)
  reviewsCount       Int     @default(0)
  totalRevenue       Decimal @default(0.0) @db.Decimal(12, 2)

  sections TeacherCourseSection[]
  offers   Offer[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  teacherCourseReviews     TeacherCourseReview[]
  teacherCourseEnrollments TeacherCourseEnrollment[]

  @@index([categoryId])
  @@index([teacherId])
  @@index([status])
  @@index([level])
  @@index([language])
  @@index([avgRating])
  @@index([totalStudentsCount])
  @@map("teacherCourses")
}

model TeacherCourseEnrollment {
  id        String        @id @default(uuid())
  studentId String
  student   User          @relation("StudentTeacherCourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    TeacherCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status          String  @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  progressPercent Decimal @default(0.0) @db.Decimal(5, 2)
  paidAmount      Decimal @default(0.0) @db.Decimal(10, 2)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([studentId, courseId]) // يمنع تسجيل الطالب في نفس الكورس مرتين
  @@index([courseId])
  @@index([studentId])
  @@map("teacher_course_enrollments")
}

model TeacherCourseReview {
  id        String        @id @default(uuid())
  rating    Int // 1 إلى 5
  comment   String        @db.Text
  isHidden  Boolean       @default(false)
  studentId String
  student   User          @relation("StudentTeacherCourseReviews", fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    TeacherCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([studentId, courseId]) // مراجعة واحدة فقط لكل طالب
  @@index([courseId])
  @@index([studentId])
  @@index([isHidden])
  @@map("teacher_course_reviews")
}

model TeacherCourseSection {
  id String @id @default(uuid())

  courseId String
  course   TeacherCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name  String
  order Int

  items TeacherCourseSectionItem[]
  quiz  TeacherCourseQuiz?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
  @@map("teacher_courses_sections")
}

model TeacherCourseSectionItem {
  id String @id @default(uuid())

  sectionId String
  section   TeacherCourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  materialType String // VIDEO | PDF
  materialLink String
  order        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, order])
  @@index([sectionId])
  @@map("teacher_course_section_items")
}

model TeacherCourseQuiz {
  id String @id @default(uuid())

  sectionId String               @unique
  section   TeacherCourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title        String
  description  String? @db.Text
  duration     Int
  passingScore Int

  questions TeacherCourseQuizQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherCourseQuizSubmissions TeacherCourseQuizSubmission[]

  @@map("teacher_course_quizzes")
}

model TeacherCourseQuizQuestion {
  id String @id @default(uuid())

  quizId String
  quiz   TeacherCourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  type  String // MCQ  | TRUE_FALSE | WRITTEN
  text  String @db.Text
  order Int

  options TeacherCourseQuizOption[]

  teacherCourseQuizAnswers TeacherCourseQuizAnswer[]

  @@unique([quizId, order])
  @@map("teacher_course_quiz_questions")
}

model TeacherCourseQuizOption {
  id String @id @default(uuid())

  questionId String
  question   TeacherCourseQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text                     String
  isCorrect                Boolean                   @default(false)
  order                    Int
  teacherCourseQuizAnswers TeacherCourseQuizAnswer[]

  @@unique([questionId, order])
  @@map("teacher_course_quiz_options")
}

model TeacherCourseQuizSubmission {
  id String @id @default(uuid())

  quizId String
  quiz   TeacherCourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentQuizSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  status String @default("PENDING_REVIEW") // PENDING_REVIEW | GRADED

  totalQuestions Int
  correctCount   Int?
  percentage     Decimal? @db.Decimal(5, 2)
  passed         Boolean?

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  answers TeacherCourseQuizAnswer[]

  @@unique([quizId, studentId])
  @@index([quizId, status])
  @@index([studentId])
  @@map("teacher_course_quiz_submissions")
}

model TeacherCourseQuizAnswer {
  id String @id @default(uuid())

  submissionId String
  submission   TeacherCourseQuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   TeacherCourseQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   TeacherCourseQuizOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  writtenAnswer String? @db.Text

  isCorrect Boolean? // null = written لسه متصححش
  feedback  String?  @db.Text

  @@unique([submissionId, questionId])
  @@map("teacher_course_quiz_answers")
}

model TeacherWorkHours {
  id        String  @id @default(uuid())
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  timezone  String  @default("Africa/Cairo")
  workHours Json[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@map("teacher_work_hours")
}

model teacherSubscription {
  id            String       @id @default(uuid())
  teacherId     String
  teacher       Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId        String?
  plan          SessionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  status        String       @default("ACTIVE") // ACTIVE | EXPIRED | COMPLETED | PENDING
  amount        Decimal      @db.Decimal(10, 2)
  type          String       @default("PLAN") // PLAN | CUSTOM
  sessionsCount Int          @default(0)
  sessionLeft   Int          @default(0)
  sessionUsed   Int          @default(0)
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@index([teacherId, studentId, status])
  @@map("teacher_subscriptions")
}
