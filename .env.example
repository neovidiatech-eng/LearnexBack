# App Settings
PORT=3015
NODE_ENV=development
MODE="DEV"

# Database Settings
POSTGRES_USER=learnx_db
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=learnx_db
DATABASE_URL="postgresql://learnx_db:your_postgres_password@localhost:5435/learnx_db?schema=public"

# Redis Settings
REDIS_PORT=6394
REDIS_URL="redis://localhost:6394"

# Hashing & Encryption
SALT=12
ENCRYPTION_SECRET="your_encryption_secret"

# JWT Signatures & Expiration
ACCESS_TOKEN_SIGNATURE="your_access_token_signature"
REFRESH_TOKEN_SIGNATURE="your_refresh_token_signature"
ACCESS_TOKEN_EXPIRES_IN=604800
REFRESH_TOKEN_EXPIRES_IN=31536000

# Email (SMTP / Gmail App Password)
APP_PASSWORD="your_app_password"
APP_EMAIL="your_email@gmail.com"

# Default Admin Credentials
ADMIN_EMAIL="admin@learnx.com"
ADMIN_PASSWORD="Password@123!"
ADMIN_NAME="Super Admin"

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Jitsi Meet WebRTC Integration
JITSI_APP_ID=learnex
JITSI_JWT_SECRET=your_jitsi_jwt_secret_64_chars_hex
JITSI_AUDIENCE=jitsi
JITSI_SUB=*
