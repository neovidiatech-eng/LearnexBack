    "prisma:studio": "prisma studio --schema=./prisma/schema",
    "seed": "node prisma/seed.js",
    "seed:Permission": "node prisma/seeders/permission.seed.js",
    "seed:sessions": "node prisma/seeders/sessions.seed.js",
    "seed:chat": "node prisma/seeders/chat.seed.js",
    "seed:tickets": "node prisma/seeders/tickets.seed.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart"
  },
  "keywords": [],
